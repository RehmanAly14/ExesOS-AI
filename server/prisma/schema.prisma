// This is the Prisma schema file for BusinessOS AI.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────
// User Model
// ──────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())   // Collision-resistant unique ID
  name      String
  email     String   @unique                // Email must be unique across all users
  password  String                          // Hashed password (never plain text)

  workspaces  Workspace[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")                            // Maps to "users" table in PostgreSQL
}

model Workspace {
  id          String   @id @default(cuid())

  name        String
  slug        String   @unique
  description String?

  logo        String?

  ownerId     String
  owner        User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

   businesses Business[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Business {
  id            String   @id @default(cuid())

  // Relationships
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Basic Information
  name          String
  slug          String   @unique
  description   String?

  industry      String
  businessType  String?
  businessStage String?

  website       String?

  country       String?
  city          String?
  timezone      String?

  currency      String?
  employees     Int?

  // AI Context
  profile        Json?
  aiPreferences  Json?
  aiContext      Json?

  documents     Document[]
  chatMessages  ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────
// Document Model
// ──────────────────────────────────────────────────
model Document {
  id            String   @id @default(cuid())

  // Relationships
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // File Info
  filename      String
  fileType      String                      // pdf | docx | txt
  fileSize      Int                         // size in bytes
  storagePath   String                      // local disk path for now (swap for cloud storage later)

  // Extraction
  extractedText String?  @db.Text
  status        String   @default("uploaded") // uploaded | processing | extracted | failed

  // Embedding pipeline (owned/updated by the embedding service)
  embeddingStatus String @default("pending") // pending | embedded | failed

  chunks        DocumentChunk[]             // Populated by embedding pipeline

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

// ──────────────────────────────────────────────────
// DocumentChunk Model
// Owned by the Embedding Pipeline (Dinesh).
// Stores text chunks and their vector embeddings.
//
// MVP NOTE: `embedding` is stored as Json (float array).
// This avoids requiring the pgvector extension for now.
// Migration path: swap `Json` for `Unsupported("vector(768)")` 
// once pgvector is enabled on the database.
// ──────────────────────────────────────────────────
model DocumentChunk {
  id         String   @id @default(cuid())

  // Relationship back to source document
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content    String   @db.Text        // Raw text content of this chunk
  embedding  Json                     // float[] stored as JSON — swap for vector(768) with pgvector
  chunkIndex Int                      // Sequential position within the document

  // Denormalised metadata for fast retrieval without joins
  workspaceId  String
  businessId   String
  documentType String?
  mimeType     String?
  title        String?
  metadata     Json?                  // Any extra parser-specific fields

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([businessId])
  @@index([workspaceId])
  @@map("document_chunks")
}

// ──────────────────────────────────────────────────
// ChatMessage Model
// Stores persistent chat history per user + business.
// ──────────────────────────────────────────────────
model ChatMessage {
  id         String   @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       String   // user | assistant
  content    String   @db.Text

  createdAt  DateTime @default(now())

  @@index([businessId, userId, createdAt])
  @@map("chat_messages")
}