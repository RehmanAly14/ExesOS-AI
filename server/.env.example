# ==================================================
# BusinessOS AI - Environment Variables
# ==================================================
# Copy this file to .env and fill in the values.
# Never commit your .env file to version control.
# ==================================================

# ── Application ──────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/businessos_ai?schema=public"

# ── JWT ──────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:3000

# ── Bcrypt ───────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── AI Pipeline (Embedding) ───────────────────────
# Fireworks AI — used by FireworksEmbeddingProvider
# Get your key at: https://fireworks.ai/
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Optional: override the default embedding model
# Default: nomic-ai/nomic-embed-text-v1.5 (768 dimensions)
FIREWORKS_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Optional: override the base URL the pipeline uses to call the Document API
# Default: http://localhost:<PORT>
API_BASE_URL=http://localhost:5000

# ── Test Script ───────────────────────────────────
# Used by scripts/testEmbeddingPipeline.js
# Set to a real businessId that has extracted documents in your DB
TEST_BUSINESS_ID=your_business_id_here
