# ==================================================
# ExecOS AI - Environment Variables
# ==================================================
# Copy this file to .env and fill in the values.
# Never commit your .env file to version control.
# ==================================================

# ── Application ──────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/execos_ai?schema=public"

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Bcrypt ───────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Fireworks AI ─────────────────────────────────
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# LLM models — validated on startup against your Fireworks account
# Use models from: GET https://api.fireworks.ai/inference/v1/models
FIREWORKS_LLM_MODEL=accounts/fireworks/models/gpt-oss-120b
FIREWORKS_EXECUTIVE_MODEL=accounts/fireworks/models/gpt-oss-120b
FIREWORKS_STRUCTURED_FALLBACK_MODEL=accounts/fireworks/models/glm-5p2
FIREWORKS_MODEL_FALLBACK_CHAIN=accounts/fireworks/models/gpt-oss-120b,accounts/fireworks/models/glm-5p2

# Performance tuning
FIREWORKS_EXECUTIVE_MAX_TOKENS=1200
FIREWORKS_REQUEST_TIMEOUT_MS=35000
RETRIEVAL_TOP_K=5

# Optional: comma-separated models that support json_schema (leave empty for json_object only)
FIREWORKS_JSON_SCHEMA_MODELS=
